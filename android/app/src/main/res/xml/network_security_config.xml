<network-security-config>
    <!-- Configuración base: Bloquear tráfico cleartext (HTTP) por defecto para seguridad -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Configuración específica para el dominio de producción -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">logixapp.dev</domain>
        <domain includeSubdomains="true">www.logixapp.dev</domain>
    </domain-config>

    <!-- Permitir HTTP (Cleartext) para Metro Bundler (Debugging local) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Alias de localhost para el emulador -->
        <domain includeSubdomains="true">192.168.1.39</domain> <!-- IP LAN detectada -->
    </domain-config>
    
    <!-- Mantenemos la IP antigua solo si es estrictamente necesario para pruebas, 
         pero idealmente debería eliminarse. Lo dejo comentado por si acaso. -->
    <!-- 
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">149.56.99.53</domain>
    </domain-config> 
    -->
</network-security-config>